{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "deny": ["SendMessage"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .agents/scripts/Write-SessionWorkflowContext.ps1 -Part 1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .agents/scripts/Write-SessionWorkflowContext.ps1 -Part 2"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .agents/scripts/Write-SessionWorkflowContext.ps1 -Part 3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.agents/scripts/Invoke-PreToolUseHook.ps1"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.agents/scripts/Invoke-SubagentStopHook.ps1"]
          }
        ]
      }
    ]
  }
}
