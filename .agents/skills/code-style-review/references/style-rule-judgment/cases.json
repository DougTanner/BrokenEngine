    "id": "real-areadamage-get",
    "expected": [],
    "code": [
      "float AreaDamage::Get(FXMVECTOR vecPosition, uint16_t uiCategoryMask, XMVECTOR& rvecClosestSource)",
      "{",
      "\tfloat fTotalDamage = 0.0f;",
      "\tfloat fClosestDistance = std::numeric_limits<float>::max();",
      "\trvecClosestSource = vecPosition;",
      "",
      "\tfor (int64_t i = 0; i < siAreaDamageSourceCount; ++i)",
      "\t{",
      "\t\tconst AreaDamageSource& rSource = sAreaDamageSources.at(static_cast<size_t>(i));",
      "\t\t// Filter by category",
      "\t\tif ((rSource.uiCategory & uiCategoryMask) == 0)",
      "\t\t{",
      "\t\t\tcontinue;",
      "\t\t}",
      "",
      "\t\t// Calculate distance",
      "\t\tXMVECTOR vecDiff = XMVectorSubtract(vecPosition, rSource.vecPosition);",
      "\t\tfloat fDistance = XMVectorGetX(XMVector3Length(vecDiff));",
      "",
      "\t\t// Skip if outside radius",
      "\t\tif (fDistance >= rSource.fRadius)",
      "\t\t{",
      "\t\t\tcontinue;",
      "\t\t}",
      "",
      "\t\t// Track closest source",
      "\t\tif (fDistance < fClosestDistance)",
      "\t\t{",
      "\t\t\tfClosestDistance = fDistance;",
      "\t\t\trvecClosestSource = rSource.vecPosition;",
      "\t\t}",
      "",
      "\t\t// Linear falloff: full damage at center, zero at edge",
      "\t\tfloat fFalloff = 1.0f - (fDistance / rSource.fRadius);",
      "\t\tfTotalDamage += rSource.fDamage * fFalloff;",
      "\t}",
      "",
      "\treturn fTotalDamage;",
      "}"
    ]
  },
