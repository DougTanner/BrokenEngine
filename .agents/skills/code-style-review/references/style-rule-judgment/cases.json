    "code": [
      "void AreaDamage::Add(const AreaDamageSource& rSource)",
      "{",
      "\tint64_t iIndex = siAreaDamageSourceCount;",
      "\tif (sAreaDamageSources.empty())",
      "\t{",
      "\t\t// Heap: one-time per-thread pre-allocation (thread_local vectors start empty to avoid allocating during mi_process_init)",
      "\t\tScopedSuppressAllocationTracking suppress;",
      "\t\tsAreaDamageSources.resize(kiAreaDamageSourcePreallocate);",
      "\t}",
