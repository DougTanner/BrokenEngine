    "id": "real-tickrealtime",
    "expected": [],
    "code": [
      "int64_t TimeStep::TickRealtime()",
      "{",
      "\tstd::chrono::nanoseconds realDeltaNs = mRealTime.GetDeltaNs(true);",
      "",
      "\tif constexpr (kbProfilingFrameSpike)",
      "\t{",
      "\t\t// Track delta for performance monitoring",
      "\t\tfloat fDelta = common::NanosecondsToFloatSeconds<float>(realDeltaNs);",
      "\t\tif (mAverageDelta.miCount > 200 && fDelta > 1.9f * mAverageDelta.Average())",
      "\t\t{",
      "\t\t\tLOG(kDefault, kWarning, \"\\n\\n\\n  deltaNs spike {} > {}\", common::Wb(fDelta, 4), common::Wb(mAverageDelta.Average(), 4));",
      "\t\t\tstatic bool sbOnce = false;",
      "\t\t\tif (!sbOnce)",
      "\t\t\t{",
      "\t\t\t\tsbOnce = true;",
      "\t\t\t\tgpProfileManager->LogTimers();",
      "\t\t\t}",
      "\t\t}",
      "\t\tLOG(kDefault, kVerbose, \"\\n\\n\");",
      "",
      "\t\tmAverageDelta = fDelta;",
      "\t}",
      "",
      "\t// Accumulate time with scaling",
      "\tmTickRemainderNs += WallToSim(realDeltaNs);",
      "",
      "#if defined(BT_SERVER)",
      "\t// Death spiral prevention: detect excessive updates and auto-reduce time scale. Server only, because",
      "\t// the server broadcasts the new ratio to every client; the client only consumes a broadcast ratio.",
      "\tif constexpr (kbDebugInput)",
      "\t{",
      "\t\tint64_t iEstimatedTicks = mTickRemainderNs / kTickNs;",
      "\t\tif (iEstimatedTicks > kiMaxTicksPerFrame && miTimeMultiply > 1) [[unlikely]]",
      "\t\t{",
      "\t\t\tLOG(kDefault, kWarning, \"Death spiral detected: {} ticks at {}x speed\", iEstimatedTicks, miTimeMultiply);",
      "\t\t\tDecreaseTimeScale(false);",
      "\t\t}",
      "\t}",
      "#endif",
      "",
      "\t// Clamp accumulator to prevent backlog cascade (e.g., after background/focus loss)",
      "\tstd::chrono::nanoseconds maxAccumulator = kTickNs * kiMaxAccumulatorTicks;",
      "\tif (mTickRemainderNs > maxAccumulator)",
      "\t{",
      "\t\tLOG(kDefault, kVerbose, \"TimeStep::TickRealtime Accumulator clamped\");",
      "\t\tmTickRemainderNs = maxAccumulator;",
      "\t}",
      "",
      "\t// Calculate number of ticks needed",
      "\tint64_t iTicks = mTickRemainderNs / kTickNs;",
      "\tmTickRemainderNs %= kTickNs;",
      "",
      "\treturn iTicks;",
      "}"
    ]
  },
