      "\tif (siAreaDamageSourceCount >= static_cast<int64_t>(sAreaDamageSources.size()))",
      "\t{",
      "\t\tLOG(kDefault, kWarning, \"AreaDamage: sAreaDamageSources overflow (count: {}, capacity: {}). Increase kiAreaDamageSourcePreallocate in AreaDamage.h\", siAreaDamageSourceCount, sAreaDamageSources.size());",
      "\t\tDEBUG_BREAK();",
      "\t\t// Heap: rare growth when area-damage source count exceeds pre-allocation",
      "\t\tScopedSuppressAllocationTracking suppress;",
      "\t\tsAreaDamageSources.resize(siAreaDamageSourceCount * 2);",
      "\t}",
      "\tsAreaDamageSources.at(static_cast<size_t>(iIndex)) = rSource;",
      "\t++siAreaDamageSourceCount;",
      "}"
    ]
