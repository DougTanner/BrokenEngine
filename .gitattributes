# Line-ending policy. Keep in sync with .editorconfig.
# Git stores all text as LF and every checkout materializes LF, so agent
# tools, Visual Studio, and fresh worktrees produce identical bytes. This
# keeps WorktreeCli's raw-byte plan comparison (PlanScheduler.cpp
# claim-next) deterministic across checkouts.
* text=auto eol=lf

# Binaries: never normalize. text=auto already auto-detects these; the
# explicit marks are belt-and-suspenders covering every tracked binary type.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.ktx       binary
*.wav       binary
*.otf       binary
*.bin       binary
*.docx      binary
*.MODEL     binary export-output
*.PreExport binary export-output
# Data-packer intermediate texture/model assets (uppercase, underscored).
*.BC4_UNORM_BLOCK     binary export-output
*.BC5_UNORM_BLOCK     binary export-output
*.BC7_UNORM_BLOCK     binary export-output
*.R16G16B16A16_SFLOAT binary
*.blend.glb export-output
*.fbx.glb   export-output
*.obj.glb   export-output
# export-output marks tracked DataPacker export outputs for the finalize primary-movement and candidate-commit checks; island textures are unset, as no ordinary build regenerates them.
**/Islands/** -export-output

# Whitespace errors `git diff --check` reports, which Invoke-StaticChecks.ps1's file-hygiene row runs.
* whitespace=blank-at-eol,-space-before-tab,-blank-at-eof
*.md -whitespace
*.txt -whitespace

# Concurrent sessions insert rows at the same place in this log; union keeps both sides' rows on rebase.
Documents/Investigations/Engine/RefactorCandidates.md merge=union
