{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/union-alpha",
	"small_model": "opencode/union-alpha",
	"shell": "pwsh",
	"enabled_providers": ["opencode"],
	"provider": {
		"opencode": {
			"whitelist": ["union-alpha"]
		}
	},
	"subagent_depth": 1,
	"default_agent": "manager",
	"permission": {
		"skill": {
			"cleanup-worktrees": "ask",
			"codex-review": "ask",
			"external-deep-analysis": "ask",
			"gaea2-diagnose": "ask",
			"gaea2-load": "ask",
			"gaea2-modify": "ask",
			"gaea2-save": "ask",
			"next-plan": "ask",
			"save-plan": "ask",
			"session-audit": "ask",
			"what": "ask"
		}
	},
	"agent": {
		"manager": {
			"description": "Main BrokenEngine session manager; delegates through the Change Workflow roles.",
			"mode": "primary",
			"model": "opencode/union-alpha",
			"prompt": "{file:../.agents/references/change-workflow.md}\n\n{file:../.agents/references/risk-tiers.md}",
			"permission": {
				"task": {
					"*": "deny",
					"planner": "allow",
					"reviewer": "allow",
					"implementer": "allow",
					"researcher": "allow",
					"locator": "allow",
					"builder": "allow",
					"mechanic": "allow"
				}
			}
		},
		"build": {
			"model": "opencode/union-alpha"
		},
		"plan": {
			"model": "opencode/union-alpha"
		},
		"title": {
			"model": "opencode/union-alpha"
		},
		"summary": {
			"model": "opencode/union-alpha"
		},
		"explore": {
			"model": "opencode/union-alpha"
		},
		"general": {
			"model": "opencode/union-alpha"
		},
		"compaction": {
			"model": "opencode/union-alpha"
		}
	}
}
