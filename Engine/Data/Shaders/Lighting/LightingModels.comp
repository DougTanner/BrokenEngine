#version 460
#extension GL_EXT_buffer_reference : require

#include "ShaderLayouts.h"
#include "LightingModelsCommon.h"

layout(local_size_x = 64) in;

struct ModelVertex
{
	vec3 f3Position;
	vec3 f3Normal;
	vec2 pf2Uv[5];
	float fJoint;
	vec4 f4Joint;
	vec4 f4Weight;
};

struct MeshData
{
	mat4 matrix;
	vec4 pf4NormalMatrix[3];
	uint jointCount;
	uint jointMatrixOffset;
};

struct JointMatrix
{
	vec4 pf4Rows[3];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer Vertices { ModelVertex pVertices[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer Instances { ModelLayout pInstances[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer Meshes { MeshData pMeshes[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer Joints { JointMatrix pJoints[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer VertexMaterials { uint pMaterials[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer OutputVertices { LightingModelVertex pOutput[]; };

layout(push_constant, scalar) uniform DeformConstants { LightingModelDeform deform; };

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= deform.uiVertexCount) return;
	uint material = VertexMaterials(deform.uiVertexMaterialAddress).pMaterials[i];
	if (material == 0xffffffffu) return;
	ModelVertex vertex = Vertices(deform.uiVertexAddress).pVertices[i];
	ModelLayout model = Instances(deform.uiInstanceAddress).pInstances[deform.uiInstance];
	MeshData data = Meshes(deform.uiMeshAddress).pMeshes[model.uiMeshDataBase + material];
	mat3 normalMatrix = mat3(data.pf4NormalMatrix[0].xyz, data.pf4NormalMatrix[1].xyz, data.pf4NormalMatrix[2].xyz);
	vec3 position;
	vec3 normal;
	if (data.jointCount > 0)
	{
		JointMatrix zeroJoint = JointMatrix(vec4[3](vec4(0.0), vec4(0.0), vec4(0.0)));
		Joints joints = Joints(deform.uiJointAddress);
		JointMatrix jm0 = vertex.f4Weight.x != 0.0 ? joints.pJoints[data.jointMatrixOffset + int(vertex.f4Joint.x)] : zeroJoint;
		JointMatrix jm1 = vertex.f4Weight.y != 0.0 ? joints.pJoints[data.jointMatrixOffset + int(vertex.f4Joint.y)] : zeroJoint;
		JointMatrix jm2 = vertex.f4Weight.z != 0.0 ? joints.pJoints[data.jointMatrixOffset + int(vertex.f4Joint.z)] : zeroJoint;
		JointMatrix jm3 = vertex.f4Weight.w != 0.0 ? joints.pJoints[data.jointMatrixOffset + int(vertex.f4Joint.w)] : zeroJoint;
		vec4 row0 = vertex.f4Weight.x * jm0.pf4Rows[0] + vertex.f4Weight.y * jm1.pf4Rows[0] + vertex.f4Weight.z * jm2.pf4Rows[0] + vertex.f4Weight.w * jm3.pf4Rows[0];
		vec4 row1 = vertex.f4Weight.x * jm0.pf4Rows[1] + vertex.f4Weight.y * jm1.pf4Rows[1] + vertex.f4Weight.z * jm2.pf4Rows[1] + vertex.f4Weight.w * jm3.pf4Rows[1];
		vec4 row2 = vertex.f4Weight.x * jm0.pf4Rows[2] + vertex.f4Weight.y * jm1.pf4Rows[2] + vertex.f4Weight.z * jm2.pf4Rows[2] + vertex.f4Weight.w * jm3.pf4Rows[2];
		mat4 skinMatrix = mat4(vec4(row0.xyz, 0.0), vec4(row1.xyz, 0.0), vec4(row2.xyz, 0.0), vec4(row0.w, row1.w, row2.w, 1.0));
		vec4 skinnedPosition = skinMatrix * vec4(vertex.f3Position, 1.0);
		position = (data.matrix * skinnedPosition).xyz;
		normal = normalize(mat3(skinMatrix) * normalMatrix * vertex.f3Normal);
	}
	else
	{
		position = (data.matrix * vec4(vertex.f3Position, 1.0)).xyz;
		normal = normalize(normalMatrix * vertex.f3Normal);
	}
	OutputVertices outputVertices = OutputVertices(deform.uiOutputAddress);
	outputVertices.pOutput[i].f3Position = position;
	outputVertices.pOutput[i].f3Normal = normal;
}
