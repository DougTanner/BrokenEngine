#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D objectShadowsBlurIntermediateSampler;
layout (set = 1, binding = 2, rgba16f) uniform writeonly image2D objectShadowsBlurTexture; // kVkFormatObjectShadows

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;

	ivec2 i2Size = imageSize(objectShadowsBlurTexture);
	if (uiX >= i2Size.x || uiY >= i2Size.y)
		return;

	int iRadius = globalLayout.iObjectShadowsBlurRadius;
	vec2 f2InvSize = 1.0f / vec2(i2Size);
	vec2 f2Uv = (vec2(uiX, uiY) + 0.5f) * f2InvSize;

	// Per-channel sigma rules out bilinear tap pairing, as in ObjectShadowsBlurH.comp.
	vec4 f4Total = vec4(0.0f);
	for (int j = -iRadius; j <= iRadius; ++j)
	{
		vec2 f2Offset = vec2(0.0f, float(j)) * f2InvSize;
		f4Total += globalLayout.pf4ObjectShadowsBlurWeights[abs(j)] * textureLod(objectShadowsBlurIntermediateSampler, f2Uv + f2Offset, 0.0f);
	}
	// R takes the whole ground coverage so terrain and water read R alone; overlapping ships cap at full coverage.
	f4Total.x = min(f4Total.x + f4Total.y, 1.0f);

	imageStore(objectShadowsBlurTexture, ivec2(uiX, uiY), 1.0f - globalLayout.fObjectShadowsIntensity * f4Total);
}
