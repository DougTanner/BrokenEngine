#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiOccupancyDilateGroupSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) readonly buffer occupancyBuffer
{
	uint occupancy[];
};

// Active tile list: [VkDispatchIndirectCommand (3 uint32s)] [packed tile indices...]
layout (set = 1, binding = 2) buffer activeTileBuffer
{
	uint uiDispatchX;
	uint uiDispatchY;
	uint uiDispatchZ;
	uint activeTiles[];
};

layout (scalar, set = 1, binding = 3) buffer ownOccupancyBuffer
{
	uint ownOccupancy[];
};

// Before SmokeSpreadComputeA, map the current output tile center through world space into the previous TextureTwo
// grid, then test the Chebyshev neighborhood of radius 2 at every Smoke Update Cadence at
// floor(prev_uv * tileCount). Zoom can move that index beyond a direct dilation radius and otherwise drop edge smoke.
// Union TextureOne's own occupancy at the output index to rewrite stale storage, clearing it so the spread re-marks
// only nonzero output.
void main()
{
	uint uiTilesX = globalLayout.uiSmokeTilesX;
	uint uiTilesY = globalLayout.uiSmokeTilesY;
	uint uiTotalTiles = uiTilesX * uiTilesY;
	uint uiTileIndex = gl_GlobalInvocationID.x;
	if (uiTileIndex >= uiTotalTiles)
		return;

	uint uiTileY = uiTileIndex / uiTilesX;
	uint uiTileX = uiTileIndex - uiTileY * uiTilesX;

	// Output tile center -> current-area world position -> previous-area UV -> previous-area tile
	vec2 f2OutputUV = (vec2(uiTileX, uiTileY) + vec2(0.5f)) / vec2(uiTilesX, uiTilesY);
	vec2 f2WorldPosition = VisibleAreaToWorld(f2OutputUV, globalLayout.f4SmokeArea);
	vec4 f4Prev = globalLayout.f4PreviousSmokeArea;
	// f2PreviousSmokeAreaSizeInverse = (1/(z-x), 1/(w-y)) folded CPU-side (SmokeUniforms.cpp), preserving component order.
	vec2 f2PrevUV = vec2(
		(f2WorldPosition.x - f4Prev.x) * globalLayout.f2PreviousSmokeAreaSizeInverse.x,
		(f2WorldPosition.y - f4Prev.y) * globalLayout.f2PreviousSmokeAreaSizeInverse.y);
	int iPrevTileX = int(floor(f2PrevUV.x * float(uiTilesX)));
	int iPrevTileY = int(floor(f2PrevUV.y * float(uiTilesY)));

	uint uiOwnBit = 1u << (uiTileIndex & 31);
	bool bActive = (atomicAnd(ownOccupancy[uiTileIndex >> 5], ~uiOwnBit) & uiOwnBit) != 0;
	// Each neighbor row's grid-clamped [x - r, x + r] span is one contiguous run of row-major occupancy bits, so it is
	// tested with word masks. Its at most 2r + 1 bits span at most 2 words only while r <= 16. A mapped center far
	// enough outside the grid leaves an empty span.
	const int iRadius = 2;
	int iMinX = max(iPrevTileX - iRadius, 0);
	int iMaxX = min(iPrevTileX + iRadius, int(uiTilesX) - 1);
	int iMinY = max(iPrevTileY - iRadius, 0);
	int iMaxY = min(iPrevTileY + iRadius, int(uiTilesY) - 1);
	for (int iNy = iMinY; iNy <= iMaxY && iMinX <= iMaxX && !bActive; ++iNy)
	{
		uint uiRowStart = uint(iNy) * uiTilesX;
		uint uiLo = uiRowStart + uint(iMinX);
		uint uiHi = uiRowStart + uint(iMaxX);
		uint uiLoMask = ~0u << (uiLo & 31u);
		uint uiHiMask = ~0u >> (31u - (uiHi & 31u));
		if ((uiLo >> 5) == (uiHi >> 5))
			bActive = (occupancy[uiLo >> 5] & uiLoMask & uiHiMask) != 0;
		else
			bActive = ((occupancy[uiLo >> 5] & uiLoMask) | (occupancy[uiHi >> 5] & uiHiMask)) != 0;
	}

	if (bActive)
	{
		uint uiSlot = atomicAdd(uiDispatchX, 1u);
		activeTiles[uiSlot] = uiTileIndex;
	}
}
