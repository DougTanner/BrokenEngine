#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiOccupancyDilateGroupSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) readonly buffer occupancyBuffer
{
	uint occupancy[];
};

// Active tile list: [VkDispatchIndirectCommand (3 uint32s)] [packed tile indices...]
layout (set = 1, binding = 2) buffer activeTileBuffer
{
	uint uiDispatchX;
	uint uiDispatchY;
	uint uiDispatchZ;
	uint activeTiles[];
};

layout (scalar, set = 1, binding = 3) readonly buffer ownOccupancyBuffer
{
	uint ownOccupancy[];
};

// Before SmokeSpreadComputeA, map the current output tile center through world space into the previous TextureTwo
// grid, then test the 5x5 (Chebyshev-2) neighborhood at floor(prev_uv * tileCount). Zoom can move that index beyond
// a direct dilation radius and otherwise drop edge smoke. Union TextureOne's own occupancy at the output index to
// rewrite stale storage.
void main()
{
	uint uiTilesX = globalLayout.uiSmokeTilesX;
	uint uiTilesY = globalLayout.uiSmokeTilesY;
	uint uiTotalTiles = uiTilesX * uiTilesY;
	uint uiTileIndex = gl_GlobalInvocationID.x;
	if (uiTileIndex >= uiTotalTiles)
		return;

	uint uiTileY = uiTileIndex / uiTilesX;
	uint uiTileX = uiTileIndex - uiTileY * uiTilesX;

	// Output tile center -> current-area world position -> previous-area UV -> previous-area tile
	vec2 f2OutputUV = (vec2(uiTileX, uiTileY) + vec2(0.5f)) / vec2(uiTilesX, uiTilesY);
	vec2 f2WorldPosition = VisibleAreaToWorld(f2OutputUV, globalLayout.f4SmokeArea);
	vec4 f4Prev = globalLayout.f4PreviousSmokeArea;
	// f2PreviousSmokeAreaSizeInv = (1/(z-x), 1/(w-y)) folded CPU-side (SmokeUniforms.cpp), preserving component order.
	vec2 f2PrevUV = vec2(
		(f2WorldPosition.x - f4Prev.x) * globalLayout.f2PreviousSmokeAreaSizeInv.x,
		(f2WorldPosition.y - f4Prev.y) * globalLayout.f2PreviousSmokeAreaSizeInv.y);
	int iPrevTileX = int(floor(f2PrevUV.x * float(uiTilesX)));
	int iPrevTileY = int(floor(f2PrevUV.y * float(uiTilesY)));

	bool bActive = (ownOccupancy[uiTileIndex >> 5] & (1u << (uiTileIndex & 31))) != 0;
	for (int iDy = -2; iDy <= 2 && !bActive; ++iDy)
	{
		for (int iDx = -2; iDx <= 2 && !bActive; ++iDx)
		{
			int iNx = iPrevTileX + iDx;
			int iNy = iPrevTileY + iDy;
			if (iNx < 0 || iNy < 0 || uint(iNx) >= uiTilesX || uint(iNy) >= uiTilesY)
				continue;

			uint uiNeighborIndex = uint(iNy) * uiTilesX + uint(iNx);
			if ((occupancy[uiNeighborIndex >> 5] & (1u << (uiNeighborIndex & 31))) != 0)
				bActive = true;
		}
	}

	if (bActive)
	{
		uint uiSlot = atomicAdd(uiDispatchX, 1u);
		activeTiles[uiSlot] = uiTileIndex;
	}
}
