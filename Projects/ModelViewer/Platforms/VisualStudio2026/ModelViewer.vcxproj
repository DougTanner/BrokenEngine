  <Target Name="ValidateDataBuildProperties" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)|$(Platform)'!='Debug|x64' and '$(Configuration)|$(Platform)'!='Release|x64'" Text="ModelViewer supports Debug|x64 or Release|x64." />
    <Error Condition="'$(DataBuildMode)'!='Local' and '$(DataBuildMode)'!='Shared'" Text="DataBuildMode must be Local or Shared." />
    <Error Condition="'$(RunDataPacker)'!='true' and '$(RunDataPacker)'!='false'" Text="RunDataPacker must be true or false." />
    <Error Condition="'$(DataBuildMode)'=='Shared' and '$(RunDataPacker)'!='false'" Text="Shared DataBuildMode requires RunDataPacker=false." />
    <Error Condition="'$(GameDataDirectoryIsAbsolute)'!='True'" Text="ModelViewer requires an absolute GameDataDirectory; configure data through /compile." />
  </Target>
  <Target Name="PrepareModelViewerData" BeforeTargets="ClCompile" DependsOnTargets="CustomBuildStep">
    <ItemGroup>
      <RequiredViewerData Include="$(GameDataDirectory)\Data.h;$(GameDataDirectory)\DataTypes.h" />
      <ViewerDataType Include="Audio;Scene;Islands;Model;Shader;Texture;Raw" />
      <RequiredViewerData Include="@(ViewerDataType->'$(GameDataDirectory)\%(Identity).h');@(ViewerDataType->'$(GameDataDirectory)\%(Identity).pack');@(ViewerDataType->'$(GameDataDirectory)\%(Identity).manifest')" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredViewerData.Identity)')" Text="ModelViewer required data input is missing: %(RequiredViewerData.Identity)" />
    <MakeDir Directories="$(ProjectDir)Build" />
    <WriteLinesToFile File="$(ProjectDir)Build\ModelViewerDataRoot.h" Lines="#pragma once&#xA;namespace game { inline constexpr const wchar_t* kpcDefaultDataDirectory = LR&quot;($(GameDataDirectory))&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
